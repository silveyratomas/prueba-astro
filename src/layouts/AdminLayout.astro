---
import "../styles/global.css";
const { title = "Admin – TuTienda" } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body class="min-h-screen bg-[var(--surface)] text-[var(--text)] flex">
    <!-- Sidebar (Fijo a la izquierda) -->
    <aside
      class="w-64 bg-[var(--card)] border-r border-[var(--card-border)] flex-shrink-0 hidden md:flex flex-col fixed inset-y-0 z-50"
    >
      <div class="p-6 border-b border-[var(--card-border)]">
        <div class="flex items-center gap-3">
          <div
            class="w-8 h-8 rounded bg-[var(--brand)] flex items-center justify-center text-white font-bold text-sm"
          >
            TP
          </div>
          <span class="font-bold text-lg">Admin Panel</span>
        </div>
      </div>

      <nav id="adminNav" class="flex-1 p-4 space-y-1 overflow-y-auto">
        <a
          href="/admin"
          class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-[var(--muted)] hover:bg-[var(--surface)] hover:text-[var(--text)] transition-colors"
        >
          <span>🏠</span> General
        </a>
        <a
          href="/admin/ventas"
          class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-[var(--muted)] hover:bg-[var(--surface)] hover:text-[var(--text)] transition-colors"
        >
          <span>💰</span> Ventas
        </a>
        <a
          href="/admin/productos"
          class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-[var(--muted)] hover:bg-[var(--surface)] hover:text-[var(--text)] transition-colors"
        >
          <span>📦</span> Productos
        </a>
        <a
          href="/admin/clientes"
          class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-[var(--muted)] hover:bg-[var(--surface)] hover:text-[var(--text)] transition-colors"
        >
          <span>👥</span> Clientes
        </a>
        <a
          href="/admin/admins"
          class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-[var(--muted)] hover:bg-[var(--surface)] hover:text-[var(--text)] transition-colors"
        >
          <span>🛡️</span> Admins
        </a>
      </nav>

      <div class="p-4 border-t border-[var(--card-border)]">
        <div class="flex items-center gap-3 mb-4 px-2">
          <div class="w-8 h-8 rounded-full bg-gray-200"></div>
          <div class="text-xs">
            <div class="font-medium">Administrador</div>
            <div id="adminProfileEmail" class="text-[var(--muted)]">
              Cargando...
            </div>
          </div>
        </div>
        <button
          id="btnLogout"
          class="w-full flex items-center justify-center gap-2 px-3 py-2 rounded-lg border border-[var(--card-border)] text-sm font-medium hover:bg-red-50 hover:text-red-600 transition-colors"
        >
          Cerrar Sesión
        </button>
        <a
          href="/"
          class="block text-center text-xs text-[var(--muted)] mt-3 hover:underline"
        >
          Ver Tienda Pública
        </a>
      </div>
    </aside>

    <!-- Contenido Principal -->
    <div class="flex-1 md:ml-64 min-h-screen flex flex-col">
      <!-- Header Móvil -->
      <header
        class="md:hidden bg-[var(--card)] border-b border-[var(--card-border)] p-4 flex items-center justify-between sticky top-0 z-40"
      >
        <span class="font-bold">Admin Panel</span>
        <button id="mobileMenuBtn" class="p-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </header>

      <!-- Mobile Drawer (Oculto por defecto) -->
      <div
        id="mobileDrawer"
        class="fixed inset-0 z-50 hidden bg-black/50 md:hidden"
      >
        <div class="bg-[var(--card)] w-64 h-full p-4 flex flex-col">
          <div class="flex justify-between items-center mb-6">
            <span class="font-bold text-lg">Menú</span>
            <button id="closeDrawerBtn" class="p-2">✕</button>
          </div>
          <nav class="space-y-2">
            <a href="/admin" class="block py-2 px-3 rounded hover:bg-gray-100"
              >General</a
            >
            <a
              href="/admin/ventas"
              class="block py-2 px-3 rounded hover:bg-gray-100">Ventas</a
            >
            <a
              href="/admin/productos"
              class="block py-2 px-3 rounded hover:bg-gray-100">Productos</a
            >
            <a
              href="/admin/clientes"
              class="block py-2 px-3 rounded hover:bg-gray-100">Clientes</a
            >
            <a
              href="/admin/admins"
              class="block py-2 px-3 rounded hover:bg-gray-100">Admins</a
            >
          </nav>
        </div>
      </div>

      <main class="flex-1 p-6 md:p-8 max-w-7xl mx-auto w-full animate-fade-in">
        <header class="mb-8">
          <h1 class="text-2xl font-bold text-[var(--text)]">{title}</h1>
        </header>
        <slot />
      </main>
    </div>

    <!-- Scripts -->
    <script src="/admin-auth.js?v=7" is:inline defer></script>
    <script src="/admin.js?v=7" is:inline defer></script>
    <script src="/admin-categories.js" defer></script>

    <script>
      // @ts-nocheck
      document.addEventListener("DOMContentLoaded", async () => {
        // Auth Guard
        try {
          if (window.tpAdmin?.requireSessionOrRedirect) {
            const ok = await tpAdmin.requireSessionOrRedirect();
            if (!ok) return;

            // Update profile email
            const emailEl = document.getElementById("adminProfileEmail");
            if (emailEl) {
              try {
                const u = await window.tpAdminAuth.me();
                if (u && u.user && u.user.email) {
                  emailEl.textContent = u.user.email;
                } else {
                  emailEl.textContent = "Sin email";
                }
              } catch {
                emailEl.textContent = "Error";
              }
            }
          }
        } catch (e) {
          console.warn("[admin] guard error:", e);
        }

        // Logout
        document.getElementById("btnLogout")?.addEventListener("click", () => {
          try {
            window.tpAdminAuth?.logout?.();
          } finally {
            location.href = "/admin/login";
          }
        });

        // Active Link Highlighting
        const nav = document.getElementById("adminNav");
        if (nav) {
          const links = Array.from(nav.querySelectorAll("a[href]"));
          const here = location.pathname.replace(/\/+$/, "");
          links.forEach((a) => {
            const href = (a.getAttribute("href") || "").replace(/\/+$/, "");
            if (
              href &&
              (here === href || (href !== "/" && here.startsWith(href)))
            ) {
              a.classList.remove("text-[var(--muted)]");
              a.classList.add(
                "bg-[var(--surface)]",
                "text-[var(--primary)]",
                "font-bold",
              );
            }
          });
        }

        // Mobile Menu Logic
        const btn = document.getElementById("mobileMenuBtn");
        const drawer = document.getElementById("mobileDrawer");
        const close = document.getElementById("closeDrawerBtn");

        btn?.addEventListener("click", () =>
          drawer?.classList.remove("hidden"),
        );
        close?.addEventListener("click", () => drawer?.classList.add("hidden"));
        drawer?.addEventListener("click", (e) => {
          if (e.target === drawer) drawer.classList.add("hidden");
        });
      });
    </script>
  </body>
</html>
