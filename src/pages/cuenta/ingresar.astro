---
import "../../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Iniciar sesión – Admin</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <body class="min-h-screen bg-[var(--surface)] text-[var(--text)] py-12">
    <main class="container mx-auto px-4">
      <div
        class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start max-w-4xl mx-auto"
      >
        <!-- Left: Info / estado -->
        <section
          class="bg-gradient-to-br from-indigo-600 to-purple-600 text-white rounded-xl p-8 shadow-lg"
        >
          <h2 class="text-2xl font-extrabold mb-2">No has iniciado sesión</h2>
          <p class="opacity-90 mb-4">
            Para gestionar tu cuenta y ver tus compras, por favor iniciá sesión
            o creá una cuenta. Tu información se guarda de forma segura en esta
            tienda.
          </p>
          <ul class="text-sm opacity-90 space-y-2 mb-4">
            <li>✔ Inicio de sesión seguro con contraseña encriptada</li>
            <li>✔ Perfiles vinculados a la tienda</li>
            <li>✔ Experiencia optimizada para móviles y escritorio</li>
          </ul>
          <div class="flex gap-3">
            <button id="showLoginBtn" class="inline-flex items-center gap-2 btn"
              >Iniciar sesión</button
            >
            <button id="showRegisterBtn" class="btn-outline"
              >Crear cuenta</button
            >
          </div>
          <div class="mt-6 text-sm opacity-80">
            <strong>Consejo:</strong> usá un email real para recibir notificaciones
            y estado de pedidos.
          </div>
        </section>

        <!-- Right: Forms -->
        <section>
          <div
            id="formWrap"
            class="bg-[var(--card)] border border-[var(--card-border)] rounded-xl p-6 shadow-sm"
          >
            <div id="loginPane">
              <h1 class="text-xl font-bold mb-3">Iniciar sesión</h1>
              <div id="loginError" class="hidden text-sm text-red-600 mb-3">
              </div>
              <form
                id="loginForm"
                class="space-y-4"
                onsubmit="handleLogin(this)"
              >
                <label class="block text-sm"
                  >Email
                  <input
                    name="email"
                    type="email"
                    required
                    class="mt-1 w-full rounded-lg border border-[var(--card-border)] px-3 py-2 bg-white"
                  />
                </label>
                <label class="block text-sm"
                  >Contraseña
                  <input
                    name="pass"
                    type="password"
                    required
                    class="mt-1 w-full rounded-lg border border-[var(--card-border)] px-3 py-2 bg-white"
                  />
                </label>
                <button
                  id="loginBtn"
                  type="submit"
                  class="btn w-full flex items-center justify-center gap-2"
                  >Entrar <span id="loginSpinner" class="hidden">⏳</span
                  ></button
                >
                <div class="mt-2 text-xs text-[var(--muted)]">
                  ¿No tenés cuenta? <a
                    href="#"
                    onclick="toggleForms()"
                    class="underline">Crear una</a
                  >
                </div>
              </form>
            </div>

            <div id="registerPane" class="hidden mt-2">
              <h1 class="text-xl font-bold mb-3">Crear cuenta</h1>
              <div id="registerError" class="hidden text-sm text-red-600 mb-3">
              </div>
              <form
                id="registerForm"
                class="space-y-4"
                onsubmit="handleRegister(this)"
              >
                <label class="block text-sm"
                  >Nombre completo
                  <input
                    name="name"
                    type="text"
                    required
                    class="mt-1 w-full rounded-lg border border-[var(--card-border)] px-3 py-2 bg-white"
                  />
                </label>
                <label class="block text-sm"
                  >Email
                  <input
                    name="email"
                    type="email"
                    required
                    class="mt-1 w-full rounded-lg border border-[var(--card-border)] px-3 py-2 bg-white"
                  />
                </label>
                <label class="block text-sm"
                  >Contraseña
                  <input
                    name="pass"
                    type="password"
                    minlength="6"
                    required
                    class="mt-1 w-full rounded-lg border border-[var(--card-border)] px-3 py-2 bg-white"
                  />
                </label>
                <button id="registerBtn" type="submit" class="btn w-full"
                  >Crear cuenta</button
                >
                <div class="mt-2 text-xs text-[var(--muted)]">
                  ¿Ya tenés cuenta? <a
                    href="#"
                    onclick="toggleForms()"
                    class="underline">Iniciá sesión</a
                  >
                </div>
              </form>
            </div>
          </div>
        </section>
      </div>
    </main>

    <script src="/user.js" defer></script>

    <script>
      // @ts-nocheck
      const setError = (id, msg) => {
        const el = document.getElementById(id);
        if (!el) return;
        if (!msg) {
          el.classList.add("hidden");
          el.textContent = "";
        } else {
          el.classList.remove("hidden");
          el.textContent = msg;
        }
      };

      const setLoading = (btnId, spinnerId, loading) => {
        const btn = document.getElementById(btnId);
        const sp = document.getElementById(spinnerId);
        if (btn) btn.disabled = loading;
        if (sp) sp.classList.toggle("hidden", !loading);
      };

      document.addEventListener("DOMContentLoaded", () => {
        document
          .getElementById("showLoginBtn")
          ?.addEventListener("click", () => {
            document
              .getElementById("loginPane")
              .scrollIntoView({ behavior: "smooth" });
          });
        document
          .getElementById("showRegisterBtn")
          ?.addEventListener("click", () => {
            toggleForms(true);
            document
              .getElementById("registerPane")
              .scrollIntoView({ behavior: "smooth" });
          });
      });

      window.handleLogin = async function (form) {
        event.preventDefault();
        setError("loginError", "");
        setLoading("loginBtn", "loginSpinner", true);
        try {
          const email = form.email.value.trim();
          const pass = form.pass.value.trim();
          await window.tpUser.login(email, pass);
          // success -> go to home so the site can show user-dependent UI
          location.href = "/";
        } catch (e) {
          setError("loginError", e.message || "Error al iniciar sesión");
        } finally {
          setLoading("loginBtn", "loginSpinner", false);
        }
      };

      window.handleRegister = async function (form) {
        event.preventDefault();
        setError("registerError", "");
        setLoading("registerBtn", "registerBtn", true);
        try {
          const name = form.name.value.trim();
          const email = form.email.value.trim();
          const pass = form.pass.value.trim();
          await window.tpUser.register({ name, email, password: pass });
          // success -> go to home so the site updates with session info
          location.href = "/";
        } catch (e) {
          setError("registerError", e.message || "Error al registrar");
        } finally {
          setLoading("registerBtn", "registerBtn", false);
        }
      };

      // convenience logout from this page (if needed)
      window.doLogout = async function () {
        await tpUser.logout();
        location.href = "/";
      };

      window.toggleForms = function (toRegister) {
        const loginPane = document.getElementById("loginPane");
        const registerPane = document.getElementById("registerPane");
        if (typeof toRegister === "boolean") {
          loginPane.classList.toggle("hidden", toRegister);
          registerPane.classList.toggle("hidden", !toRegister);
        } else {
          loginPane.classList.toggle("hidden");
          registerPane.classList.toggle("hidden");
        }
      };

      // redirect if already logged
      document.addEventListener("DOMContentLoaded", async () => {
        if (await tpUser.isLogged()) location.href = "/cuenta/perfil";
      });
    </script>
  </body>
</html>
