---
import "../../styles/global.css";
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <title>Entrar – Tienda</title>
        <meta name="viewport" content="width=device-width, initial-scale=1" />
    </head>
    <body
        class="min-h-screen bg-[var(--surface)] text-[var(--text)] flex items-center justify-center py-12"
    >
        <main class="w-full max-w-md">
            <div
                class="bg-[var(--card)] border border-[var(--card-border)] rounded-xl p-8 shadow-lg"
            >
                <h1 class="text-2xl font-bold mb-4">Entrar a la tienda</h1>
                <div id="formError" class="hidden text-sm text-red-600 mb-3">
                </div>
                <form id="loginForm" class="space-y-4">
                    <label class="block text-sm"
                        >Email
                        <input
                            name="email"
                            type="email"
                            required
                            class="mt-1 w-full rounded-lg border border-[var(--card-border)] px-3 py-2 bg-white"
                        />
                    </label>
                    <label class="block text-sm"
                        >Contraseña
                        <input
                            name="pass"
                            type="password"
                            required
                            minlength="6"
                            class="mt-1 w-full rounded-lg border border-[var(--card-border)] px-3 py-2 bg-white"
                        />
                    </label>
                    <button id="loginBtn" class="btn w-full">Entrar</button>
                </form>
                <div class="mt-4 text-sm text-[var(--muted)]">
                    ¿No tenés cuenta? <a
                        href="/cuenta/registro"
                        class="underline">Registrate</a
                    >
                </div>
            </div>
        </main>

        <script src="/shop-auth.js" defer></script>
        <script>
            // @ts-nocheck
            const form = document.getElementById("loginForm");
            if (form) {
                form.addEventListener("submit", handleLogin);
            }

            async function handleLogin(e) {
                e.preventDefault();
                document.getElementById("formError").classList.add("hidden");
                const f = e.target;
                const email = f.email.value.trim();
                const pass = f.pass.value.trim();
                const btn = document.getElementById("loginBtn");
                try {
                    if (btn) btn.disabled = true;
                    await shopAuth.login(email, pass);
                    location.href = "/cuenta";
                } catch (err) {
                    console.error("[shop.login] error", err);
                    const el = document.getElementById("formError");
                    let msg =
                        err && err.message
                            ? err.message
                            : "Error al iniciar sesión";
                    // Normalize common cases
                    if (err && err.status === 401)
                        msg = "Email o contraseña incorrectos";
                    if (msg && msg.toLowerCase().includes("credenciales"))
                        msg = "Email o contraseña incorrectos";
                    if (msg === "network_error")
                        msg =
                            "Error de red o CORS. Mirá la consola y pestaña Network.";
                    el.textContent = msg;
                    el.classList.remove("hidden");
                } finally {
                    if (btn) btn.disabled = false;
                }
            }

            // redirect if already logged
            document.addEventListener("DOMContentLoaded", async () => {
                const t = shopAuth.getToken();
                if (t) {
                    const me = await shopAuth.me();
                    if (me) location.href = "/cuenta";
                }
                // no store input required for customers
            });
        </script>
    </body>
</html>
