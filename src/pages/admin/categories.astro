---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Categorías – Admin">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-3xl font-bold">Panel Admin — Categorías</h1>
            <p class="text-sm text-[var(--muted)] mt-1">
                Organizá tu catálogo con una estructura de árbol.
            </p>
        </div>
        <div class="flex gap-2">
            <button class="btn-outline" onclick="__resetForm()"
                >Nueva categoría</button
            >
            <button class="btn" onclick="__loadList()"
                >Actualizar listado</button
            >
        </div>
    </div>

    <div class="grid lg:grid-cols-[1fr,400px] gap-8 items-start">
        <!-- Columna Izquierda: Árbol de Categorías -->
        <div class="space-y-4">
            <div
                class="flex items-center justify-between bg-[var(--card)] border border-[var(--card-border)] p-4 rounded-xl"
            >
                <div class="flex items-center gap-3">
                    <span class="text-sm font-medium">Tienda:</span>
                    <input
                        id="storeFilter"
                        value="mi-tienda-demo"
                        class="rounded-lg border border-[var(--card-border)] px-3 py-1 bg-white text-sm"
                        disabled
                    />
                </div>
                <span class="text-xs text-[var(--muted)]"
                    >Hacé clic en una categoría para editarla.</span
                >
            </div>

            <div
                class="bg-[var(--card)] border border-[var(--card-border)] rounded-2xl p-6 shadow-sm min-h-[400px]"
            >
                <ul id="catList" class="space-y-2">
                    <li class="text-[var(--muted)]">Cargando...</li>
                </ul>
            </div>
        </div>

        <!-- Columna Derecha: Formulario (Sticky) -->
        <div class="sticky top-6">
            <form
                id="catForm"
                class="bg-[var(--card)] border border-[var(--card-border)] rounded-2xl p-6 shadow-lg"
            >
                <div class="mb-5">
                    <h2 id="formTitle" class="text-xl font-semibold">
                        Nueva categoría
                    </h2>
                    <p
                        id="formSubtitle"
                        class="text-sm text-[var(--muted)] mt-1"
                    >
                        Creá una categoría raíz o una subcategoría.
                    </p>
                </div>

                <input type="hidden" name="id" id="catId" />
                <input
                    type="hidden"
                    name="storeSlug"
                    id="storeSlugHidden"
                    value="mi-tienda-demo"
                />

                <div class="space-y-4">
                    <div>
                        <label class="text-sm block mb-2 font-medium"
                            >Nombre</label
                        >
                        <input
                            name="name"
                            required
                            class="w-full rounded-lg border border-[var(--card-border)] px-4 py-3 bg-white text-sm"
                            placeholder="Ej: Electrónica"
                        />
                    </div>

                    <div>
                        <label class="text-sm block mb-2 font-medium"
                            >Slug</label
                        >
                        <input
                            name="slug"
                            required
                            class="w-full rounded-lg border border-[var(--card-border)] px-4 py-3 bg-white text-sm"
                            placeholder="ej: electronica"
                        />
                    </div>

                    <div>
                        <label class="text-sm block mb-2 font-medium"
                            >Categoría Padre (Slug)</label
                        >
                        <div class="relative">
                            <input
                                name="parentSlug"
                                id="parentSlugInput"
                                class="w-full rounded-lg border border-[var(--card-border)] px-4 py-3 bg-white text-sm"
                                placeholder="Dejar vacío si es raíz"
                            />
                            <p class="text-xs text-[var(--muted)] mt-1">
                                Podés escribir el slug del padre o seleccionarlo
                                del árbol.
                            </p>
                        </div>
                    </div>

                    <div class="pt-2">
                        <label
                            class="inline-flex items-center gap-2 cursor-pointer"
                        >
                            <input
                                type="checkbox"
                                name="isOffer"
                                class="w-4 h-4 rounded border-gray-300 text-[var(--brand)] focus:ring-[var(--brand)]"
                            />
                            <span class="text-sm font-medium"
                                >Es una categoría de Ofertas</span
                            >
                        </label>
                        <p class="text-xs text-[var(--muted)] ml-6 mt-1">
                            Los productos en esta categoría aparecerán
                            destacados.
                        </p>
                    </div>

                    <div class="flex gap-3 pt-4">
                        <button
                            type="button"
                            class="btn-outline flex-1"
                            onclick="__resetForm()">Cancelar</button
                        >
                        <button type="submit" class="btn flex-1" id="submitBtn"
                            >Guardar</button
                        >
                    </div>

                    <div
                        id="deleteContainer"
                        class="hidden pt-2 border-t border-[var(--card-border)] mt-4"
                    >
                        <button
                            type="button"
                            class="w-full text-red-600 text-sm hover:underline"
                            onclick="__deleteCurrent()"
                        >
                            Eliminar esta categoría
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <script src="/admin-auth.js" defer></script>
    <script src="/admin-categories.js" defer></script>
</AdminLayout>
