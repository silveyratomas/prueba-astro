---
import "../../styles/global.css";
---

<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <title>Iniciar sesión TuTienda Admin</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="min-h-screen flex items-center justify-center bg-[#0B0F19] text-white font-['Inter',sans-serif] overflow-hidden relative selection:bg-purple-500 selection:text-white"
  >
    <!-- Background Effects -->
    <div class="fixed inset-0 z-0 pointer-events-none">
      <div
        class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-purple-600/20 blur-[120px]"
      >
      </div>
      <div
        class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] rounded-full bg-orange-600/10 blur-[120px]"
      >
      </div>
      <!-- Grid Pattern -->
      <div
        class="absolute inset-0 bg-[url('https://astro.build/assets/grid.svg')] opacity-[0.15]"
      >
      </div>
    </div>

    <div class="w-full max-w-md p-6 relative z-10">
      <!-- Logo -->
      <div class="flex justify-center mb-8">
        <a href="/landing" class="flex items-center gap-3 group">
          <div
            class="relative w-10 h-10 flex items-center justify-center transition-transform group-hover:scale-110"
          >
            <div
              class="absolute inset-0 bg-gradient-to-tr from-orange-500 to-purple-600 rounded-xl rotate-6 opacity-70"
            >
            </div>
            <div
              class="relative w-full h-full bg-[#171C2F] rounded-xl border border-white/10 flex items-center justify-center"
            >
              <span class="text-xl">🚀</span>
            </div>
          </div>
          <span class="font-bold text-2xl tracking-tight">TuTienda</span>
        </a>
      </div>

      <form
        id="loginForm"
        action="#"
        method="post"
        class="bg-[#171C2F]/80 backdrop-blur-xl border border-white/10 rounded-2xl p-8 shadow-2xl space-y-6"
        onsubmit="return __login(event)"
      >
        <div class="text-center">
          <h1 class="text-xl font-bold mb-2">Bienvenido de nuevo</h1>
          <p class="text-sm text-slate-400">
            Ingresa a tu panel de administración
          </p>
        </div>

        <div class="space-y-4">
          <div>
            <label
              class="block text-xs font-medium text-slate-400 mb-1.5 uppercase tracking-wider"
              >Email</label
            >
            <input
              name="email"
              type="email"
              required
              placeholder="tu@email.com"
              class="w-full rounded-lg bg-[#0B0F19] border border-white/10 px-4 py-3 text-white placeholder-slate-600 focus:border-purple-500 focus:ring-1 focus:ring-purple-500 outline-none transition-all"
            />
          </div>

          <div>
            <label
              class="block text-xs font-medium text-slate-400 mb-1.5 uppercase tracking-wider"
              >Contraseña</label
            >
            <div class="relative">
              <input
                id="passInput"
                name="pass"
                type="password"
                required
                placeholder=""
                class="w-full rounded-lg bg-[#0B0F19] border border-white/10 px-4 py-3 text-white placeholder-slate-600 focus:border-purple-500 focus:ring-1 focus:ring-purple-500 outline-none transition-all pr-20"
              />
              <button
                type="button"
                id="togglePass"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-medium text-slate-500 hover:text-white transition-colors"
                >Mostrar</button
              >
            </div>
          </div>
        </div>

        <div
          id="adminLoginError"
          class="hidden text-sm text-red-400 bg-red-500/10 p-3 rounded-lg border border-red-500/20"
        >
        </div>

        <button
          id="adminLoginBtn"
          type="submit"
          class="w-full py-3.5 rounded-xl bg-gradient-to-r from-orange-500 to-purple-600 text-white font-bold shadow-lg shadow-purple-500/25 hover:shadow-purple-500/40 transition-all hover:-translate-y-0.5 disabled:opacity-50 disabled:cursor-not-allowed"
          >Entrar</button
        >

        <div class="text-center space-y-2">
          <p class="text-xs text-slate-500">
            Demo: <span class="font-mono text-slate-400"
              >buleria.games@gmail.com</span
            > / <span class="font-mono text-slate-400">owner123</span>
          </p>
          <p class="text-sm text-slate-500">
            ¿No tienes cuenta? <a
              href="/admin/register"
              class="text-purple-400 hover:text-purple-300 font-medium transition-colors"
              >Regístrate gratis</a
            >
          </p>
        </div>
      </form>
    </div>

    <!-- Cargar helper primero -->
    <script src="/admin-auth.js?v=7" is:inline defer></script>

    <script>
      // @ts-nocheck
      function setAdminError(msg) {
        const el = document.getElementById("adminLoginError");
        if (!el) return;
        if (!msg) {
          el.classList.add("hidden");
          el.textContent = "";
        } else {
          el.classList.remove("hidden");
          el.textContent = msg;
        }
      }

      window.__login = async function (ev) {
        ev.preventDefault();
        setAdminError("");
        const form = document.getElementById("loginForm");
        const email = form.email.value.trim();
        const pass = document.getElementById("passInput").value.trim();
        const btn = document.getElementById("adminLoginBtn");
        try {
          btn.disabled = true;
          btn.textContent = "Verificando...";

          if (
            !window.tpAdminAuth ||
            typeof window.tpAdminAuth.login !== "function"
          ) {
            throw new Error("client_auth_not_loaded");
          }
          await tpAdminAuth.login(email, pass);
          location.href = "/admin";
          return false;
        } catch (e) {
          console.error("[admin.login] error", e);
          const msg = e?.message || "No se pudo iniciar sesión";
          if (msg === "client_auth_not_loaded") {
            setAdminError(
              "Error interno: helper de auth no cargado. Refrescá la página.",
            );
          } else if (msg.includes("401") || msg.includes("credenciales")) {
            setAdminError("Email o contraseña incorrectos");
          } else {
            setAdminError(msg);
          }
          return false;
        } finally {
          btn.disabled = false;
          btn.textContent = "Entrar";
        }
      };

      document.addEventListener("DOMContentLoaded", async () => {
        // toggle password visibility
        document.getElementById("togglePass")?.addEventListener("click", () => {
          const inp = document.getElementById("passInput");
          if (!inp) return;
          const isPwd = inp.type === "password";
          inp.type = isPwd ? "text" : "password";
          document.getElementById("togglePass").textContent = isPwd
            ? "Ocultar"
            : "Mostrar";
        });

        // si ya hay token válido, pasá directo
        try {
          if (window.tpAdminAuth?.isLogged() && (await tpAdminAuth.me())) {
            location.href = "/admin";
          }
        } catch (e) {
          // no hacemos nada, mostramos el formulario
        }
      });
    </script>
  </body>
</html>
