---
import "../styles/landing.css";
---

<html lang="es" class="dark">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>TuTienda La Plataforma de E-commerce del Futuro</title>
        <meta
            name="description"
            content="Velocidad estelar para tu negocio. La plataforma SaaS inspirada en la tecnología moderna."
        />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap"
            rel="stylesheet"
        />
    </head>
    <body
        class="bg-[#0B0F19] !text-white font-['Inter',sans-serif] overflow-x-hidden selection:bg-purple-500 selection:text-white"
        style="background-color: #0B0F19;"
    >
        <div class="fixed inset-0 z-0 pointer-events-none">
            <div
                class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-purple-600/20 blur-[120px]"
            >
            </div>
            <div
                class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] rounded-full bg-orange-600/10 blur-[120px]"
            >
            </div>
            <div
                class="absolute top-[20%] right-[10%] w-[300px] h-[300px] rounded-full bg-blue-600/10 blur-[100px]"
            >
            </div>
            <!-- Grid -->
            <div
                class="absolute inset-0 bg-[url('https://astro.build/assets/grid.svg')] opacity-[0.15]"
            >
            </div>
        </div>

        <!-- Navbar -->
        <nav
            class="fixed w-full z-50 border-b border-white/10 bg-[#0B0F19]/80 backdrop-blur-xl"
        >
            <div
                class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between"
            >
                <div class="flex items-center gap-3">
                    <!-- Logo Icon -->
                    <div
                        class="relative w-10 h-10 flex items-center justify-center"
                    >
                        <div
                            class="absolute inset-0 bg-gradient-to-tr from-orange-500 to-purple-600 rounded-xl rotate-6 opacity-70"
                        >
                        </div>
                        <div
                            class="relative w-full h-full bg-[#171C2F] rounded-xl border border-white/10 flex items-center justify-center"
                        >
                            <span class="text-xl">🚀</span>
                        </div>
                    </div>
                    <span class="font-bold text-xl tracking-tight text-white"
                        >TuTienda</span
                    >
                </div>

                <div class="hidden md:flex items-center gap-8">
                    <a
                        href="#features"
                        class="text-sm font-medium !text-white hover:text-orange-400 transition-colors"
                        >Características</a
                    >
                    <a
                        href="#showcase"
                        class="text-sm font-medium !text-white hover:text-orange-400 transition-colors"
                        >Showcase</a
                    >
                </div>

                <div class="flex items-center gap-4">
                    <a
                        href="/admin/login"
                        class="text-sm font-medium !text-white hover:text-orange-400 transition-colors hidden sm:block"
                        >Ingresar</a
                    >
                    <a
                        href="/admin/register"
                        class="group relative px-6 py-2.5 rounded-full bg-white text-black font-semibold text-sm overflow-hidden transition-transform hover:scale-105"
                    >
                        <div
                            class="absolute inset-0 bg-gradient-to-r from-orange-400 via-purple-500 to-blue-500 opacity-0 group-hover:opacity-20 transition-opacity"
                        >
                        </div>
                        <span>Comenzar Gratis</span>
                    </a>
                </div>
            </div>
        </nav>

        <!-- Hero Section -->
        <section class="relative z-10 pt-40 pb-32 px-6">
            <div class="max-w-5xl mx-auto text-center">
                <div
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/10 bg-white/5 backdrop-blur-sm mb-8 animate-fade-in-up"
                >
                    <span class="flex h-2 w-2 rounded-full bg-orange-500"
                    ></span>
                    <span
                        class="text-xs font-medium text-orange-200 tracking-wide uppercase"
                        >Proximamente...</span
                    >
                </div>

                <h1
                    class="text-5xl md:text-7xl lg:text-8xl font-extrabold tracking-tight leading-[1.1] mb-8"
                >
                    E-commerce a la <br />
                    <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 via-purple-500 to-blue-500 animate-gradient-x"
                        >Velocidad de la Luz</span
                    >
                </h1>

                <p
                    class="text-lg md:text-xl text-slate-300 max-w-2xl mx-auto mb-12 leading-relaxed"
                >
                    La plataforma SaaS que combina la potencia de un backend
                    robusto con un frontend estático ultrarrápido. Diseñado para
                    desarrolladores, amado por vendedores.
                </p>

                <div
                    class="flex flex-col sm:flex-row items-center justify-center gap-6"
                >
                    <a
                        href="/admin/register"
                        class="w-full sm:w-auto px-8 py-4 rounded-full bg-gradient-to-r from-orange-500 to-purple-600 text-white font-bold text-lg shadow-lg shadow-purple-500/25 hover:shadow-purple-500/40 transition-all hover:-translate-y-1"
                    >
                        Crear Tienda
                    </a>
                    <a
                        href="/"
                        class="w-full sm:w-auto px-8 py-4 rounded-full bg-white/5 border border-white/10 text-white font-semibold hover:bg-white/10 transition-all flex items-center justify-center gap-2"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
                            ></path><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                            ></path></svg
                        >
                        Ver Demo
                    </a>
                </div>
            </div>

            <!-- Hero Image / Dashboard -->
            <div class="mt-24 max-w-6xl mx-auto relative group">
                <div
                    class="absolute -inset-1 bg-gradient-to-r from-orange-500 via-purple-600 to-blue-600 rounded-2xl blur opacity-20 group-hover:opacity-40 transition duration-1000"
                >
                </div>
                <div
                    class="relative rounded-2xl bg-[#171C2F] border border-white/10 overflow-hidden shadow-2xl"
                >
                    <div
                        class="h-10 bg-[#0B0F19] border-b border-white/10 flex items-center px-4 gap-2"
                    >
                        <div
                            class="w-3 h-3 rounded-full bg-red-500/20 border border-red-500/50"
                        >
                        </div>
                        <div
                            class="w-3 h-3 rounded-full bg-yellow-500/20 border border-yellow-500/50"
                        >
                        </div>
                        <div
                            class="w-3 h-3 rounded-full bg-green-500/20 border border-green-500/50"
                        >
                        </div>
                        <div
                            class="ml-4 px-3 py-1 rounded-md bg-white/5 text-[10px] text-slate-500 font-mono"
                        >
                            admin.tutienda.com
                        </div>
                    </div>
                    <img
                        src="/imgs/admin.png"
                        alt="Dashboard"
                        class="w-full h-auto opacity-90"
                    />
                </div>
            </div>
        </section>

        <!-- Bento Grid Features -->
        <section id="features" class="py-32 px-6 relative z-10">
            <div class="max-w-7xl mx-auto">
                <h2
                    class="text-3xl md:text-5xl font-bold text-center mb-16 !text-white"
                >
                    Todo lo que necesitas. <br />
                    <span class="text-slate-300">Nada que no necesites.</span>
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- Card 1: Large -->
                    <div
                        class="md:col-span-2 p-8 rounded-3xl bg-[#171C2F] border border-white/10 hover:border-purple-500/50 transition-colors group"
                        style="background-color: #171C2F;"
                    >
                        <div class="h-full flex flex-col justify-between">
                            <div>
                                <div
                                    class="w-12 h-12 rounded-2xl bg-purple-500/20 flex items-center justify-center text-purple-400 mb-6 group-hover:scale-110 transition-transform"
                                >
                                    <svg
                                        class="w-6 h-6"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        ><path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M13 10V3L4 14h7v7l9-11h-7z"
                                        ></path></svg
                                    >
                                </div>
                                <h3 class="text-2xl font-bold mb-4">
                                    Rendimiento Estelar
                                </h3>
                                <p class="text-slate-300 leading-relaxed">
                                    Construido sobre Astro 5, entregamos HTML
                                    puro por defecto. Tus clientes navegarán
                                    entre productos instantáneamente, sin
                                    esperas ni spinners infinitos.
                                </p>
                            </div>
                            <div class="mt-8 flex gap-2">
                                <div
                                    class="px-3 py-1 rounded-md bg-green-500/10 text-green-400 text-xs font-mono border border-green-500/20"
                                >
                                    Lighthouse 100
                                </div>
                                <div
                                    class="px-3 py-1 rounded-md bg-blue-500/10 text-blue-400 text-xs font-mono border border-blue-500/20"
                                >
                                    0kb JS Inicial
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Card 2 -->
                    <div
                        class="p-8 rounded-3xl bg-[#171C2F] border border-white/10 hover:border-orange-500/50 transition-colors group"
                        style="background-color: #171C2F;"
                    >
                        <div
                            class="w-12 h-12 rounded-2xl bg-orange-500/20 flex items-center justify-center text-orange-400 mb-6 group-hover:scale-110 transition-transform"
                        >
                            <svg
                                class="w-6 h-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"
                                ></path></svg
                            >
                        </div>
                        <h3 class="text-xl font-bold mb-3">
                            Base de Datos Robusta
                        </h3>
                        <p class="text-slate-300 text-sm">
                            PostgreSQL + Prisma ORM aseguran que tus datos estén
                            siempre íntegros y tipados.
                        </p>
                    </div>

                    <!-- Card 3 -->
                    <div
                        class="p-8 rounded-3xl bg-[#171C2F] border border-white/10 hover:border-blue-500/50 transition-colors group"
                        style="background-color: #171C2F;"
                    >
                        <div
                            class="w-12 h-12 rounded-2xl bg-blue-500/20 flex items-center justify-center text-blue-400 mb-6 group-hover:scale-110 transition-transform"
                        >
                            <svg
                                class="w-6 h-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
                                ></path></svg
                            >
                        </div>
                        <h3 class="text-xl font-bold mb-3">Mobile First</h3>
                        <p class="text-slate-300 text-sm">
                            Diseño responsivo que se adapta a cualquier
                            dispositivo. Tus clientes compran desde donde sea.
                        </p>
                    </div>

                    <!-- Card 4: Large -->
                    <div
                        class="md:col-span-2 p-8 rounded-3xl bg-[#171C2F] border border-white/10 hover:border-pink-500/50 transition-colors group relative overflow-hidden"
                        style="background-color: #171C2F;"
                    >
                        <div class="relative z-10">
                            <div
                                class="w-12 h-12 rounded-2xl bg-pink-500/20 flex items-center justify-center text-pink-400 mb-6 group-hover:scale-110 transition-transform"
                            >
                                <svg
                                    class="w-6 h-6"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    ><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                    ></path></svg
                                >
                            </div>
                            <h3 class="text-2xl font-bold mb-4">
                                Panel de Control Intuitivo
                            </h3>
                            <p class="text-slate-300 leading-relaxed max-w-md">
                                Gestiona productos, categorías, clientes y
                                ventas desde una interfaz moderna y rápida. Sin
                                complicaciones.
                            </p>
                        </div>
                        <!-- Decorative image -->
                        <img
                            src="/imgs/producto.png"
                            class="absolute right-[-50px] bottom-[-50px] w-[300px] rounded-lg shadow-2xl border border-white/10 transform -rotate-6 opacity-50 group-hover:opacity-80 group-hover:scale-105 transition-all duration-500"
                        />
                    </div>
                </div>
            </div>
        </section>

        <!-- Showcase / Tech Stack -->
        <section class="py-24 border-y border-white/5 bg-black/40">
            <div class="max-w-7xl mx-auto px-6 text-center">
                <p
                    class="text-sm font-mono text-slate-300 mb-8 uppercase tracking-widest"
                >
                    Potenciado por tecnología moderna
                </p>
                <div
                    class="flex flex-wrap justify-center items-center gap-12 md:gap-20 opacity-90 hover:opacity-100 transition-all duration-500"
                >
                    <!-- Logos (Text representations for simplicity, styled to look like logos) -->
                    <div class="flex items-center gap-2">
                        <span class="text-2xl font-bold text-orange-500"
                            >Astro</span
                        >
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-2xl font-bold text-white"
                            >Express</span
                        >
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-2xl font-bold text-blue-400"
                            >Prisma</span
                        >
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-2xl font-bold text-cyan-400"
                            >Tailwind</span
                        >
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-2xl font-bold text-blue-300"
                            >PostgreSQL</span
                        >
                    </div>
                </div>
            </div>
        </section>

        <!-- Documentation Section -->
        <section
            id="docs"
            class="py-32 px-6 relative z-10 bg-[#0B0F19]"
            style="background-color: #0B0F19;"
        >
            <div class="max-w-4xl mx-auto">
                <div class="text-center mb-16">
                    <h2 class="text-3xl md:text-5xl font-bold mb-6 !text-white">
                        Documentación del Proyecto
                    </h2>
                    <p class="text-slate-300 text-lg">
                        Todo lo que necesitas saber sobre la arquitectura y
                        funcionamiento de TuTienda.
                    </p>
                </div>

                <div class="space-y-12">
                    <!-- 1. ¿Qué es TuTienda? -->
                    <div
                        class="bg-[#171C2F] border border-white/10 rounded-3xl p-8 md:p-12"
                        style="background-color: #171C2F;"
                    >
                        <h3 class="text-2xl font-bold mb-6 text-orange-400">
                            1. ¿Qué es TuTienda?
                        </h3>
                        <p class="text-slate-300 leading-relaxed mb-6">
                            TuTienda es una plataforma que permite a
                            emprendedores crear y gestionar su propia tienda
                            online en cuestión de minutos. A diferencia de los
                            e-commerce tradicionales lentos y pesados, TuTienda
                            utiliza una arquitectura moderna que separa el
                            contenido estático (Frontend) de la lógica de
                            negocio (Backend), garantizando una velocidad de
                            carga instantánea para los clientes finales.
                        </p>
                        <ul class="space-y-3 text-slate-300">
                            <li class="flex items-start gap-3">
                                <span class="text-green-400 mt-1">✓</span>
                                <span
                                    ><strong>Panel de Administración:</strong> Gestión
                                    completa de productos, categorías y órdenes.</span
                                >
                            </li>
                            <li class="flex items-start gap-3">
                                <span class="text-green-400 mt-1">✓</span>
                                <span
                                    ><strong>Tienda Pública:</strong> Catálogo de
                                    productos, carrito de compras y checkout optimizado.</span
                                >
                            </li>
                            <li class="flex items-start gap-3">
                                <span class="text-green-400 mt-1">✓</span>
                                <span
                                    ><strong>SaaS Multi-tenant:</strong> Preparado
                                    para alojar múltiples tiendas.</span
                                >
                            </li>
                            <li class="flex items-start gap-3">
                                <span class="text-green-400 mt-1">✓</span>
                                <span
                                    ><strong>Diseño Moderno:</strong> Interfaz oscura
                                    (Dark Mode), minimalista y responsiva.</span
                                >
                            </li>
                        </ul>
                    </div>

                    <!-- 2. Tecnologías Utilizadas -->
                    <div
                        class="bg-[#171C2F] border border-white/10 rounded-3xl p-8 md:p-12"
                        style="background-color: #171C2F;"
                    >
                        <h3 class="text-2xl font-bold mb-6 text-purple-400">
                            2. Tecnologías Utilizadas
                        </h3>
                        <p class="text-slate-300 mb-6">
                            El proyecto está construido sobre un stack
                            tecnológico de última generación ("Bleeding Edge"):
                        </p>

                        <div class="grid md:grid-cols-2 gap-8">
                            <div>
                                <h4
                                    class="text-xl font-semibold text-white mb-4"
                                >
                                    Frontend (La cara visible)
                                </h4>
                                <ul class="space-y-3 text-slate-300">
                                    <li class="flex items-start gap-3">
                                        <span class="text-purple-400 mt-1"
                                            >•</span
                                        >
                                        <span
                                            ><strong>Astro 5:</strong> Framework
                                            web principal. HTML estático ultrarrápido.
                                            "Zero JS by default".</span
                                        >
                                    </li>
                                    <li class="flex items-start gap-3">
                                        <span class="text-purple-400 mt-1"
                                            >•</span
                                        >
                                        <span
                                            ><strong>Tailwind CSS 4:</strong> Motor
                                            de estilos para diseño rápido y consistente.</span
                                        >
                                    </li>
                                    <li class="flex items-start gap-3">
                                        <span class="text-purple-400 mt-1"
                                            >•</span
                                        >
                                        <span
                                            ><strong>Vanilla JavaScript:</strong
                                            > Interactividad ligera sin frameworks
                                            pesados.</span
                                        >
                                    </li>
                                </ul>
                            </div>
                            <div>
                                <h4
                                    class="text-xl font-semibold text-white mb-4"
                                >
                                    Backend (El cerebro)
                                </h4>
                                <ul class="space-y-3 text-slate-300">
                                    <li class="flex items-start gap-3">
                                        <span class="text-blue-400 mt-1">•</span
                                        >
                                        <span
                                            ><strong>Node.js + Express:</strong>
                                            Servidor API RESTful.</span
                                        >
                                    </li>
                                    <li class="flex items-start gap-3">
                                        <span class="text-blue-400 mt-1">•</span
                                        >
                                        <span
                                            ><strong>Prisma ORM:</strong> Capa de
                                            abstracción de base de datos segura y
                                            tipada.</span
                                        >
                                    </li>
                                    <li class="flex items-start gap-3">
                                        <span class="text-blue-400 mt-1">•</span
                                        >
                                        <span
                                            ><strong>PostgreSQL:</strong> Base de
                                            datos relacional robusta.</span
                                        >
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Arquitectura de APIs -->
                    <div
                        class="bg-[#171C2F] border border-white/10 rounded-3xl p-8 md:p-12"
                        style="background-color: #171C2F;"
                    >
                        <h3 class="text-2xl font-bold mb-6 text-blue-400">
                            3. Arquitectura de APIs
                        </h3>
                        <p class="text-slate-300 mb-6">
                            API REST interna que comunica el Frontend con la
                            Base de Datos.
                        </p>

                        <div class="space-y-6">
                            <div class="border-l-2 border-orange-500 pl-4">
                                <h4 class="text-lg font-semibold text-white">
                                    🔐 Autenticación (/api/auth)
                                </h4>
                                <p class="text-slate-400 text-sm">
                                    Registro, Login y Verificación de sesión
                                    mediante JWT.
                                </p>
                            </div>
                            <div class="border-l-2 border-purple-500 pl-4">
                                <h4 class="text-lg font-semibold text-white">
                                    📦 Productos (/api/products)
                                </h4>
                                <p class="text-slate-400 text-sm">
                                    CRUD completo de productos. Listado público
                                    y gestión privada.
                                </p>
                            </div>
                            <div class="border-l-2 border-blue-500 pl-4">
                                <h4 class="text-lg font-semibold text-white">
                                    📦 Órdenes (/api/orders)
                                </h4>
                                <p class="text-slate-400 text-sm">
                                    Creación de órdenes (Checkout) y gestión de
                                    estados (Admin).
                                </p>
                            </div>
                            <div class="border-l-2 border-green-500 pl-4">
                                <h4 class="text-lg font-semibold text-white">
                                    📂 Categorías (/api/categories)
                                </h4>
                                <p class="text-slate-400 text-sm">
                                    Gestión de la estructura de árbol de las
                                    categorías.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <section class="py-32 px-6 text-center relative overflow-hidden">
            <div
                class="absolute inset-0 bg-gradient-to-b from-transparent to-purple-900/20 pointer-events-none"
            >
            </div>

            <div class="max-w-3xl mx-auto relative z-10">
                <h2 class="text-4xl md:text-6xl font-bold mb-8">
                    ¿Listo para despegar?
                </h2>
                <p class="text-xl text-slate-300 mb-10">
                    Únete a la nueva era del comercio electrónico. Sin tarjetas
                    de crédito. Sin compromisos.
                </p>
                <a
                    href="/admin/register"
                    class="inline-block px-10 py-5 rounded-full bg-white text-black font-bold text-xl hover:scale-105 transition-transform shadow-[0_0_40px_-10px_rgba(255,255,255,0.3)]"
                >
                    Comenzar Ahora
                </a>
            </div>
        </section>

        <!-- Footer -->
        <footer class="border-t border-white/10 bg-[#0B0F19] pt-16 pb-8 px-6">
            <div
                class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-8 mb-12"
            >
